{
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "baseUrl": "./",
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "allowArbitraryExtensions": true,
        "types": ["bun"]
    },
    "include": ["src/**/*.ts"]
}
